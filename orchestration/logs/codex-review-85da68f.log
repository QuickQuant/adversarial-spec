  1098	def call_models_parallel(
  1099	    models: list[str],
  1100	    spec: str,
  1101	    round_num: int,
  1102	    doc_type: str,
  1103	    press: bool = False,
  1104	    focus: Optional[str] = None,
  1105	    persona: Optional[str] = None,
  1106	    context: Optional[str] = None,
  1107	    preserve_intent: bool = False,
  1108	    codex_reasoning: str = DEFAULT_CODEX_REASONING,
  1109	    codex_search: bool = False,
  1110	    timeout: int = 1800,
  1111	    bedrock_mode: bool = False,
  1112	    bedrock_region: Optional[str] = None,
  1113	    depth: Optional[str] = None,
  1114	    session_id: Optional[str] = None,
  1115	    cwd: str | None = None,
  1116	) -> list[ModelResponse]:
  1117	    """Call multiple models in parallel and collect responses.
  1118	
  1119	    Each model result is written to disk immediately upon completion so that
  1120	    killing the process (e.g. when one model is stuck retrying) does not lose
  1121	    results from models that already finished.
  1122	
  1123	    An Antigravity STOP is terminal: sibling critics that are already running
  1124	    finish, but results arriving after the STOP are quarantined into the
  1125	    incident directory (never saved as partial results, never synthesized),
  1126	    and the STOP is re-raised once every worker has returned.
  1127	    """
  1128	    results = []
  1129	    stop: agy_sandbox.AgyStop | None = None
  1130	    with concurrent.futures.ThreadPoolExecutor(max_workers=len(models)) as executor:
  1131	        future_to_model = {
  1132	            executor.submit(
  1133	                call_single_model,
  1134	                model,
  1135	                spec,
  1136	                round_num,
  1137	                doc_type,
  1138	                press,
  1139	                focus,
  1140	                persona,
  1141	                context,
  1142	                preserve_intent,
  1143	                codex_reasoning,
  1144	                codex_search,
  1145	                timeout,
  1146	                bedrock_mode,
  1147	                bedrock_region,
  1148	                depth,
  1149	                cwd,
  1150	            ): model
  1151	            for model in models
  1152	        }
  1153	        for future in concurrent.futures.as_completed(future_to_model):
  1154	            try:
  1155	                result = future.result()
  1156	            except agy_sandbox.AgyStop as exc:
  1157	                stop = stop or exc
  1158	                continue
  1159	            if stop is not None:
  1160	                agy_sandbox.quarantine_result(stop, f"round-{round_num}-{result.model}", {
  1161	                    "model": result.model, "agreed": result.agreed, "response": result.response,
  1162	                    "spec": result.spec, "error": result.error,
  1163	                })
  1164	                continue
  1165	            results.append(result)
  1166	            _save_partial_result(result, round_num, session_id)
  1167	    if stop is not None:
  1168	        raise stop
  1169	    return results
