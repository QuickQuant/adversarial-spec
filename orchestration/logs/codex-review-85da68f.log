  1072	def preflight_models(
  1073	    models: list[str],
  1074	    codex_reasoning: str = DEFAULT_CODEX_REASONING,
  1075	    timeout: int = PREFLIGHT_TIMEOUT,
  1076	    cwd: str | None = None,
  1077	) -> dict[str, Optional[str]]:
  1078	    """Ping every model in parallel before the real dispatch.
  1079	
  1080	    Catches invalid model names (404s), dead auth, and missing CLIs in
  1081	    seconds instead of discovering them after the longest model finishes
  1082	    its full critique. Returns {model: error_or_None}.
  1083	    """
  1084	    results: dict[str, Optional[str]] = {}
  1085	    with concurrent.futures.ThreadPoolExecutor(max_workers=len(models)) as executor:
  1086	        future_to_model = {
  1087	            executor.submit(
  1088	                _preflight_single, model, codex_reasoning, timeout, cwd
  1089	            ): model
  1090	            for model in models
  1091	        }
  1092	        for future in concurrent.futures.as_completed(future_to_model):
  1093	            model = future_to_model[future]
  1094	            results[model] = future.result()
  1095	    return results
