   979	def _unmasked_probe(argv: list[str]) -> int:
   980	    wrapped = ["bwrap", "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", *argv]
   981	    return subprocess.run(wrapped, capture_output=True, text=True, timeout=30).returncode
   982	
   983	
   984	@pytest.mark.parametrize("name", sorted(PROBES))
   985	def test_host_socket_unreachable_in_sandbox(h, name):
   986	    """TC-12.0/1/2: each socket probe fails inside the dispatch sandbox and succeeds unmasked (paired oracle)."""
   987	    argv = PROBES[name]
   988	    if shutil.which(argv[0]) is None or _unmasked_probe(argv) != 0:
   989	        pytest.skip(f"UNVERIFIABLE on this host: unmasked {name} probe unreachable, masking cannot be shown")
   990	    h.behave(default={"steps": [{"op": "run", "argv": argv}]})
   991	    text, _, _ = _dispatch(h)
   992	    line = next(x for x in text.splitlines() if x.startswith(f"run {argv[0]} rc="))
   993	    assert not line.startswith(f"run {argv[0]} rc=0"), line
