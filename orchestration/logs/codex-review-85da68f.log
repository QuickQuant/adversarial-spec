   238	    monkeypatch.setattr(session, "SESSION_STATE_PATH", run_dir / ".adversarial-spec" / "session-state.json")
   239	    argv = ["debate.py", "critique", "--models", models_arg, "--timeout", "30", *OVERRIDE, *extra]
   240	    if round_cwd is not None:
