   529	def _fresh_process_dispatch(h: Harness, repo: Path) -> subprocess.CompletedProcess:
   530	    code = (
   531	        "import sys, models, agy_sandbox\n"
   532	        "models.ANTIGRAVITY_AVAILABLE = True\n"
   533	        "try:\n"
   534	        f"    models.call_antigravity_model('s', 'u', {AGY_MODEL!r}, timeout=30, cwd={str(repo)!r})\n"
   535	        "    print('DISPATCHED')\n"
   536	        "except agy_sandbox.AgyStop as e:\n"
   537	        "    print('STOP', e.kind); print(e)\n"
   538	    )
