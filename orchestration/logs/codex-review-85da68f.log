   108	def _git(repo: Path, *args: str) -> str:
   109	    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, check=True).stdout
   110	
   111	
   112	def _init_repo(path: Path) -> Path:
   113	    path.mkdir(parents=True)
   114	    _git(path, "init", "-q")
   115	    _git(path, "config", "user.email", "t@example.invalid")
   116	    _git(path, "config", "user.name", "t")
   117	    (path / "tracked.txt").write_text("base\n")
   118	    (path / "other.txt").write_text("other\n")
   119	    _git(path, "add", ".")
   120	    _git(path, "commit", "-qm", "base")
   121	    return path
   122	
   123	
   124	def _common_dir(repo: Path) -> Path:
   125	    raw = _git(repo, "rev-parse", "--git-common-dir").strip()
   126	    p = Path(raw)
   127	    return (p if p.is_absolute() else repo / p).resolve()
   128	
   129	
   130	class Harness:
   131	    def __init__(self, root: Path) -> None:
   132	        self.root = root
   133	        self.bin = root / "bin"
   134	        self.bin.mkdir(parents=True)
   135	        self.behavior_path = root / "behavior.json"
   136	        self.claude_delay = root / "claude-delay.txt"
   137	        self.claude_delay.write_text("0")
   138	        self.repo = _init_repo(root / "repo")
   139	        self.base = root / "dispatch"
   140	        self.launches: list[list[str]] = []
   141	        self.behave()
   142	        agy = self.bin / "agy"
   143	        agy.write_text(FAKE_AGY.replace("BEHAVIOR_PATH", repr(str(self.behavior_path))))
   144	        agy.chmod(0o755)
   145	        claude = self.bin / "claude"
   146	        claude.write_text(FAKE_CLAUDE.replace("DELAY_PATH", repr(str(self.claude_delay))))
   147	        claude.chmod(0o755)
   148	
   149	    def behave(self, default: dict | None = None, rules: list[dict] | None = None) -> None:
   150	        self.behavior_path.write_text(json.dumps({"default": default or {}, "rules": rules or []}))
   151	
   152	    def state(self, repo: Path | None = None) -> Path:
   153	        return _common_dir(repo or self.repo) / STATE_DIRNAME
   154	
   155	    def incidents(self, repo: Path | None = None) -> list[dict]:
   156	        found = []
   157	        for f in sorted((self.state(repo) / "incidents").glob("*/incident.json")):
   158	            data = json.loads(f.read_text())
   159	            data["_dir"] = f.parent
   160	            found.append(data)
   161	        return found
   162	
   163	    def windows(self, repo: Path | None = None) -> list[dict]:
   164	        f = self.state(repo) / "windows.jsonl"
   165	        return [json.loads(line) for line in f.read_text().splitlines()] if f.exists() else []
   166	
   167	    @property
   168	    def agy_launches(self) -> int:
   169	        return len(self.launches)
   170	
   171	
   172	def _is_agy_launch(argv) -> bool:
   173	    if not isinstance(argv, (list, tuple)):
   174	        return False
   175	    return "--prompt" in argv and any(os.path.basename(str(a)) == "agy" for a in argv)
