   524	def _porcelain_state(repo_root: Path) -> dict[str, Optional[tuple[int, int]]]:
   525	    proc = subprocess.run(
   526	        ["git", "-C", str(repo_root), "status", "--porcelain=v1", "-z", "--untracked-files=all"],
